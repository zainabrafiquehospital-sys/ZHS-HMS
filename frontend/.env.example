# Copy this file to .env.local and adjust if your backend runs
# somewhere other than the default below. Never commit .env.local.
#
# Both variables below are prefixed NEXT_PUBLIC_ and are bundled into
# the client-side JavaScript by design (Next.js convention) — they are
# not secrets. This app never stores an actual secret in any frontend
# env variable; the access token lives in memory only and the refresh
# token is an httpOnly cookie the backend sets directly (see
# src/services/api/tokenStore.js).

# Base URL of the FastAPI backend (no trailing slash, no /api/v1 suffix
# — that prefix is appended automatically, see src/core/config/env.js).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Must match the backend's API_V1_PREFIX version segment.
NEXT_PUBLIC_API_VERSION=v1

# Display name shown in the UI (page titles, sidebar).
NEXT_PUBLIC_APP_NAME="Gynecology HMS"
