# Copy this file to .env and fill in real values for your environment.
# Never commit the resulting .env file.

# ---- Application ----
APP_NAME="Zainab Rafique Hospital"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# IANA zone name used to render local wall-clock times on printed
# documents (registration slips, invoices) — every stored timestamp is
# UTC; this is the only place UTC-to-local conversion is configured.
# See app/shared/printing/service.py.
DISPLAY_TIMEZONE=Asia/Karachi

# ---- CORS ----
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# The frontend's login page, linked from the signup-approval email.
FRONTEND_LOGIN_URL=http://localhost:3000/login

# ---- Database ----
# PostgreSQL connection strings — async (asyncpg) for the application,
# sync (psycopg2) for Alembic migrations. Replace the placeholders with
# your own database user/password/host/port/name.
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_SYNC_URL=postgresql+psycopg2://<db_user>:<db_password>@<db_host>:5432/<db_name>

# ---- Redis ----
REDIS_URL=redis://<redis_host>:6379/0

# ---- JWT (RS256 key rotation) ----
# JWT_KEYS_DIR must point to a directory containing one <kid>.pem RSA
# private key file per active key (gitignored locally; a mounted secrets
# volume in production — see app/core/jwt_keys.py). Generate a dev key
# with:
#   python -c "from cryptography.hazmat.primitives.asymmetric import rsa; \
#     from cryptography.hazmat.primitives import serialization; \
#     key = rsa.generate_private_key(public_exponent=65537, key_size=2048); \
#     open('keys/dev.pem', 'wb').write(key.private_bytes( \
#       encoding=serialization.Encoding.PEM, \
#       format=serialization.PrivateFormat.PKCS8, \
#       encryption_algorithm=serialization.NoEncryption()))"
# JWT_ACTIVE_KID selects which key signs new tokens (must match a
# <kid>.pem filename in JWT_KEYS_DIR); every file in the directory
# remains valid for verification.
JWT_KEYS_DIR=./keys
JWT_ACTIVE_KID=dev

# How long (seconds) after a refresh token is rotated a repeat
# presentation of it is still treated as a benign concurrent-request
# race instead of a reuse attack. See app/core/token_rotation.py.
REFRESH_REUSE_GRACE_WINDOW_SECONDS=5

# ---- JWT claims / lifetimes and account security policy ----
# See app/modules/auth/service.py and app/modules/auth/token_service.py.
JWT_ISSUER=gynecology-hms
JWT_AUDIENCE=gynecology-hms-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1
JWT_REFRESH_TOKEN_REMEMBER_ME_EXPIRE_DAYS=30
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15
PASSWORD_HISTORY_DEPTH=5

# ---- Login rate limiting (per source IP, independent of account lockout) ----
# See app/core/rate_limit.py.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Self-service signup / forgot-password OTP ----
# See app/modules/auth/otp_service.py.
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_RATE_LIMIT_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_VERIFY_RATE_LIMIT_ATTEMPTS=10
OTP_VERIFY_RATE_LIMIT_WINDOW_SECONDS=3600

# ---- Outbound email (OTP codes, approval confirmations) ----
# See app/shared/email/service.py. Leave SMTP_HOST unset to fall back to
# logging each email's content instead of sending it — useful for local
# development before real credentials exist.
#
# Gmail requires an "App Password" for SMTP access (Google Account ->
# Security -> 2-Step Verification -> App Passwords), NOT the account's
# actual login password. Generate one for zainabrafiquehospital@gmail.com
# and put it in SMTP_PASSWORD below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=zainabrafiquehospital@gmail.com
SMTP_PASSWORD=<gmail-app-password>
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=zainabrafiquehospital@gmail.com
SMTP_FROM_NAME="Zainab Rafique Hospital"

# ---- Logging ----
LOG_LEVEL=INFO
