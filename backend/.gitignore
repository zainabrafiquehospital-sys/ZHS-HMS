# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Environment files — never commit real values
.env
.env.*
!.env.example

# JWT signing keys — see app/core/jwt_keys.py's module docstring.
# Production provisions this directory from a secrets volume/manager;
# it is never a repository artifact, dev included.
keys/
*.pem
*.key

# Logs
*.log

# OS
.DS_Store
Thumbs.db
